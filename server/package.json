{
  "name": "server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate": "npx sequelize-cli db:migrate --config config/config.cjs",
    "migrate:create": "npx sequelize-cli migration:generate --config config/config.cjs",
    "ingest:embed": "node --import tsx ingestion/processEmbeddings.ts",
    "ingest": "node --import tsx ingestion/run.ts"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "@supabase/server": "^1.4.1",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "path": "^0.12.7",
    "pdf-parse": "^2.4.5",
    "pg": "^8.12.0",
    "postgres": "^4.1.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "sequelize": "^6.37.6",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.1",
    "@types/pg": "^8.11.6",
    "eslint": "^9.19.0",
    "globals": "^15.14.0",
    "sequelize-cli": "^6.6.3",
    "tsx": "^4.6.0",
    "typescript": "~5.7.2"
  }
}
